# ce-demo-netbox-metal3 -- everything this demo needs to know about YOUR lab.
#
#   cp env.example env.sh && $EDITOR env.sh && source env.sh
#
# env.sh is yours and is not meant to be committed; env.example is the shape.
# hack/verify-netbox-import.sh and hack/seed-netbox.py both read these, and the
# docs use the same names, so a sourced env plus copy-paste gets you through
# docs/runbook.md without hand-editing commands.
#
# Only the first block is mandatory. Everything else has a working default.

## --- clusters ------------------------------------------------------------

# kube context for the cluster running vCluster Platform. The NetBox sync runs
# HERE, so this cluster is what must be able to reach NetBox over the network.
export PLATFORM_CONTEXT="platform"

# kube context for the cluster running Metal3/Ironic, where BareMetalHosts are
# created. Often the same cluster as the Platform; set both anyway so the
# scripts stay honest about which half they are looking at.
export METAL3_CONTEXT="metal3"

# The name the Platform knows that cluster by -- what goes in the NodeProvider's
# spec.metal3.clusterRef.cluster. Not necessarily the kube context name.
export METAL3_CLUSTER="metal3-cluster"

# The Metal3 NodeProvider to wire the import into. It must already exist and
# already work; this demo adds an inventory source to it, it does not create it.
export NODE_PROVIDER="metal3-dc1"

# Base URL of NetBox: scheme + host, no trailing /api.
export NETBOX_URL="https://netbox.example.com"

## --- namespaces ----------------------------------------------------------

export PLATFORM_NAMESPACE="vcluster-platform"   # where the connector Secret lives
export METAL3_NS="metal3-system"                # where BareMetalHosts live
export NETBOX_NAMESPACE="netbox"                # where the NetBox release lives

## --- NetBox record -------------------------------------------------------

# The tag an operator puts on a device to say "import this one". Devices
# without it are invisible to the platform.
export NETBOX_SYNC_TAG="vcluster-sync"

# Where the fleet sits in the DCIM. These become the netbox.vcluster.com/site
# and /location labels your NodeType pools select on.
export NETBOX_SITE="dc1"
export NETBOX_LOCATION="row-1"

# Tokens. Create both by hand in the NetBox UI (docs/runbook.md step 2); no
# script here can create one for you. Paste the VALUE only, never the scheme
# word NetBox prints in front of it.
export NETBOX_PLATFORM_TOKEN=""   # read-only, goes in the connector Secret
export NETBOX_TOKEN=""            # write-enabled, used by hack/seed-netbox.py

## --- NetBox install (only if you are installing NetBox from this repo) ----

export NETBOX_HOSTNAME="netbox.example.com"     # the HTTPRoute hostname
export NETBOX_ADMIN_EMAIL="admin@example.com"
export NETBOX_ADMIN_PASSWORD=""                 # --set superuser.password
export STORAGE_CLASS="local-path"
export GATEWAY_NAME="eg"                        # Gateway API Gateway to attach to
export GATEWAY_NAMESPACE="envoy-gateway-system"
export GATEWAY_SECTION="https"                  # listener name

## --- emulated fleet only -------------------------------------------------
# Skip this whole block if your BMCs are real. It describes the sushy-tools /
# libvirt lab that hack/seed-netbox.py and hack/bmc-ip-aliases.sh exist for.

# Node label that pins NetBox (and Ironic, and the DHCP proxy) to the one host
# that owns the provisioning bridge. Whatever your lab already uses.
export BMH_HOST_LABEL="demo.vcluster.com/bmh-host"

export PROVISION_BRIDGE="br-provision"
export PROVISION_CIDR="172.22.0.0/24"

# First address handed to an emulated BMC. Must sit outside the bridge address,
# any DHCP VIP, and the NodeProvider's own provisioning IPAM range.
export BMC_IP_START="172.22.0.3"
export BMC_IP_COUNT="12"

# The login written into every device's bmc_username / bmc_password custom
# fields. Emulated BMCs do not check it; real ones do.
export BMC_USERNAME="admin"
export BMC_PASSWORD="password"

# Path to the inventory hack/seed-netbox.py reads.
export VM_INVENTORY="$HOME/vmetal-sushy-demo/configs/vm-inventory.txt"
